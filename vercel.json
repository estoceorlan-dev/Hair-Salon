{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["sin1"],
  "installCommand": "npm ci --include=dev && npm ci --prefix server --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/salon.js": {
      "includeFiles": "server/node_modules/{@img/**,bcrypt/prebuilds/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/salon" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/book", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" }
  ]
}
