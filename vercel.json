{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "regions": ["sin1"],
  "installCommand": "npm ci --include=dev && npm ci --prefix server --omit=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/salon.js": {
      "includeFiles": "server/node_modules/{@img/**,bcrypt/prebuilds/**}"
    }
  },
  "routes": [
    { "src": "^/api(?:/.*)?$", "dest": "/api/salon" },
    { "src": "^/app(?:/.*)?$", "dest": "/index.html" },
    { "src": "^/(?:book|account)/?$", "dest": "/index.html" },
    { "handle": "filesystem" }
  ]
}
