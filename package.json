{
  "name": "romel-hair-salon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently --kill-others --names UI,API \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "test:db": "npm --prefix server run test:db",
    "db:local:setup": "npm --prefix server run db:local:setup",
    "db:local:start": "npm --prefix server run db:local:start",
    "db:local:stop": "npm --prefix server run db:local:stop",
    "db:migrate": "npm --prefix server run db:migrate --",
    "db:status": "npm --prefix server run db:status --",
    "db:seed:demo": "npm --prefix server run db:seed:demo --",
    "db:reset:demo": "npm --prefix server run db:reset:demo --"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
