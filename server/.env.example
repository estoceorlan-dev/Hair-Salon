# Run npm run db:local:setup to generate ignored local connection settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Manila

# Independent development, demo, and test databases. Never commit credentials.
DATABASE_URL=
DEMO_DATABASE_URL=
TEST_DATABASE_URL=
DB_CONNECTION_TIMEOUT_MS=2000

# Generated privately by auth:local:setup; required in production (32+ characters).
JWT_SECRET=
SESSION_TTL_SECONDS=28800
# Set to 1 only behind one trusted reverse proxy (e.g. the future Render service).
TRUST_PROXY_HOPS=0
