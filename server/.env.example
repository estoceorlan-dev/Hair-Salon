# Optional in Phase 1: the API starts with defaults even without this file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Manila

# Leave empty until Phase 2. Never commit real credentials.
DATABASE_URL=
DB_CONNECTION_TIMEOUT_MS=2000

# Reserved for Phase 3. Leave empty; a real JWT secret must be at least 32 characters.
JWT_SECRET=
