# Run npm run db:local:setup to generate ignored local connection settings.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Manila

# Independent development, demo, and test databases. Never commit credentials.
DATABASE_URL=
DEMO_DATABASE_URL=
TEST_DATABASE_URL=
DB_CONNECTION_TIMEOUT_MS=2000

# Generated privately by auth:local:setup; required in production (32+ characters).
JWT_SECRET=
SESSION_TTL_SECONDS=28800
# Set to 1 when running behind Vercel's trusted proxy.
TRUST_PROXY_HOPS=0

# Neon Object Storage credentials for the same branch as DATABASE_URL.
NEON_STORAGE_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
